<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Hiperbárica Cartaginesa</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Terapia de oxigenación hiperbárica. Agenda tu cita por WhatsApp con Hiperbárica Cartaginesa.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f3f6fb;
    --bg-elevated:#ffffff;
    --bg-sunken:#e7edf6;
    --ink:#0e1726;
    --ink-dim:#4c5a70;
    --ink-faint:#8493a8;
    --line:#d7e0ec;
    --accent:#0d7ec9;
    --accent-2:#0f9e8f;
    --accent-ink:#ffffff;
    --silver-a:#0e1726;
    --silver-b:#3a5578;
    --whatsapp:#1fb855;
    --glow-a: rgba(13,126,201,0.18);
    --glow-b: rgba(15,158,143,0.14);
    --shadow: 0 20px 50px -25px rgba(14,23,38,0.35);
    --radius-lg: 22px;
    --radius-md: 14px;
    --radius-sm: 9px;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#080d18;
      --bg-elevated:#101a2c;
      --bg-sunken:#0c1526;
      --ink:#eef3fb;
      --ink-dim:#9fb0c9;
      --ink-faint:#647591;
      --line:#1e2c45;
      --accent:#3ba7ff;
      --accent-2:#2dd4bf;
      --accent-ink:#04101c;
      --silver-a:#eef3fb;
      --silver-b:#9fc4e8;
      --whatsapp:#25d366;
      --glow-a: rgba(59,167,255,0.28);
      --glow-b: rgba(45,212,191,0.20);
      --shadow: 0 30px 70px -30px rgba(0,0,0,0.6);
    }
  }
  :root[data-theme="dark"]{
    --bg:#080d18;
    --bg-elevated:#101a2c;
    --bg-sunken:#0c1526;
    --ink:#eef3fb;
    --ink-dim:#9fb0c9;
    --ink-faint:#647591;
    --line:#1e2c45;
    --accent:#3ba7ff;
    --accent-2:#2dd4bf;
    --accent-ink:#04101c;
    --silver-a:#eef3fb;
    --silver-b:#9fc4e8;
    --whatsapp:#25d366;
    --glow-a: rgba(59,167,255,0.28);
    --glow-b: rgba(45,212,191,0.20);
    --shadow: 0 30px 70px -30px rgba(0,0,0,0.6);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:"Manrope", ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.55;
    overflow-x:hidden;
  }
  h1,h2,h3{
    font-family:"Rajdhani","Manrope",sans-serif;
    font-weight:700;
    letter-spacing:0.01em;
    text-wrap:balance;
    margin:0;
  }
  p{margin:0;}
  .mono{
    font-family:"IBM Plex Mono", ui-monospace, monospace;
    font-variant-numeric:tabular-nums;
  }
  a{color:inherit;}
  img,svg{display:block; max-width:100%;}
  .wrap{
    width:100%;
    max-width:1180px;
    margin:0 auto;
    padding:0 clamp(20px,5vw,48px);
  }
  section{position:relative;}

  /* ---------- nav ---------- */
  .nav{
    position:sticky; top:0; z-index:50;
    background:color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px clamp(20px,5vw,48px);
    max-width:1180px; margin:0 auto;
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-family:"Rajdhani",sans-serif; font-weight:700;
    font-size:1.15rem; letter-spacing:0.02em;
    text-decoration:none; color:var(--ink);
  }
  .brand-mark{
    width:34px; height:34px; flex:none;
  }
  .brand small{
    display:block; font-family:"Manrope",sans-serif; font-weight:600;
    font-size:0.6rem; letter-spacing:0.14em; color:var(--accent-2);
    text-transform:uppercase;
  }
  .nav-cta{
    display:flex; align-items:center; gap:10px;
  }
  .nav-phone{
    display:none;
    font-family:"IBM Plex Mono",monospace;
    font-size:0.85rem; color:var(--ink-dim);
  }
  @media (min-width:640px){ .nav-phone{ display:inline; } }

  /* ---------- buttons ---------- */
  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:13px 24px;
    border-radius:999px;
    font-family:"Manrope",sans-serif; font-weight:700; font-size:0.92rem;
    text-decoration:none; cursor:pointer;
    border:1px solid transparent;
    transition:transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    white-space:nowrap;
  }
  .btn:active{ transform:translateY(1px); }
  .btn-primary{
    background:linear-gradient(135deg, var(--accent), var(--accent-2));
    color:var(--accent-ink);
    box-shadow:0 12px 30px -12px var(--glow-a);
  }
  .btn-primary:hover{ box-shadow:0 16px 36px -10px var(--glow-a); transform:translateY(-1px); }
  .btn-ghost{
    background:transparent;
    color:var(--ink);
    border-color:var(--line);
  }
  .btn-ghost:hover{ border-color:var(--accent); color:var(--accent); }
  .btn-whatsapp{
    background:var(--whatsapp);
    color:#04150b;
    box-shadow:0 12px 26px -12px rgba(31,184,85,0.55);
  }
  .btn-whatsapp:hover{ transform:translateY(-1px); }
  .btn-sm{ padding:9px 16px; font-size:0.82rem; }
  .btn svg{ width:18px; height:18px; flex:none; }

  /* ---------- hero ---------- */
  .hero{
    padding:clamp(52px,9vw,104px) 0 clamp(60px,8vw,96px);
    position:relative;
  }
  .hero::before{
    content:"";
    position:absolute; inset:-10% -10% auto -10%;
    height:640px;
    background:
      radial-gradient(480px 320px at 18% 20%, var(--glow-a), transparent 70%),
      radial-gradient(420px 300px at 82% 10%, var(--glow-b), transparent 70%);
    pointer-events:none;
    z-index:0;
  }
  .hero-grid{
    position:relative; z-index:1;
    display:grid; grid-template-columns:1.1fr 0.9fr; gap:clamp(32px,5vw,64px);
    align-items:center;
  }
  @media (max-width:900px){ .hero-grid{ grid-template-columns:1fr; } }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:"IBM Plex Mono",monospace;
    font-size:0.72rem; letter-spacing:0.16em; text-transform:uppercase;
    color:var(--accent-2);
    padding:6px 14px 6px 10px;
    border:1px solid var(--line);
    border-radius:999px;
    background:var(--bg-elevated);
    margin-bottom:20px;
  }
  .eyebrow .dot{
    width:7px; height:7px; border-radius:50%;
    background:var(--accent-2);
    box-shadow:0 0 0 3px var(--glow-b);
    animation:breathe 3.4s ease-in-out infinite;
  }
  .hero h1{
    font-size:clamp(2.5rem, 5.6vw, 4.1rem);
    line-height:1.03;
    background:linear-gradient(100deg, var(--silver-a) 30%, var(--silver-b) 60%, var(--accent-2) 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero-sub{
    margin-top:20px;
    font-size:clamp(1.02rem, 1.6vw, 1.2rem);
    color:var(--ink-dim);
    max-width:46ch;
  }
  .hero-sub strong{ color:var(--ink); font-weight:700; }
  .hero-actions{
    display:flex; flex-wrap:wrap; gap:14px; margin-top:32px;
  }
  .hero-stats{
    display:flex; gap:clamp(20px,4vw,40px); margin-top:44px; flex-wrap:wrap;
  }
  .stat-num{
    font-family:"IBM Plex Mono",monospace; font-weight:500;
    font-size:1.5rem; color:var(--ink);
  }
  .stat-label{
    font-size:0.76rem; color:var(--ink-faint); letter-spacing:0.04em; margin-top:2px;
  }

  /* ---------- chamber illustration ---------- */
  .chamber-stage{
    position:relative; z-index:1;
    aspect-ratio:1/1;
    display:flex; align-items:center; justify-content:center;
  }
  .chamber-stage svg{ width:100%; height:100%; }
  .ring{
    fill:none; stroke:var(--accent); stroke-opacity:0.35;
  }
  .pulse-ring{
    animation:pulse-out 3.4s ease-out infinite;
    transform-origin:center;
  }
  .pulse-ring.d2{ animation-delay:1.13s; }
  .pulse-ring.d3{ animation-delay:2.26s; }
  @keyframes pulse-out{
    0%{ transform:scale(0.72); opacity:0.55; }
    100%{ transform:scale(1.18); opacity:0; }
  }
  @keyframes breathe{
    0%,100%{ opacity:1; transform:scale(1); }
    50%{ opacity:0.45; transform:scale(0.78); }
  }
  .porthole-glow{ animation:breathe 4.2s ease-in-out infinite; }

  /* ---------- section shell ---------- */
  .section-head{
    max-width:640px;
    margin-bottom:clamp(32px,5vw,52px);
  }
  .section-head .eyebrow{ margin-bottom:16px; }
  .section-head h2{
    font-size:clamp(1.8rem, 3.4vw, 2.5rem);
  }
  .section-head p{
    margin-top:14px; color:var(--ink-dim); font-size:1.02rem; max-width:60ch;
  }
  .band{ padding:clamp(60px,8vw,100px) 0; }
  .band-sunken{ background:var(--bg-sunken); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }

  /* ---------- qué es ---------- */
  .about-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:clamp(28px,5vw,56px);
    align-items:start;
  }
  @media (max-width:820px){ .about-grid{ grid-template-columns:1fr; } }
  .about-copy p + p{ margin-top:16px; }
  .about-copy{ color:var(--ink-dim); font-size:1.03rem; }
  .about-copy strong{ color:var(--ink); }
  .spec-list{
    list-style:none; margin:24px 0 0; padding:0;
    display:grid; gap:10px;
  }
  .spec-list li{
    display:flex; align-items:baseline; gap:12px;
    font-size:0.92rem; color:var(--ink-dim);
    padding-bottom:10px; border-bottom:1px dashed var(--line);
  }
  .spec-list .mono{ color:var(--accent); min-width:78px; }

  /* ---------- benefits ---------- */
  .benefit-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:18px;
  }
  @media (max-width:900px){ .benefit-grid{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:600px){ .benefit-grid{ grid-template-columns:1fr; } }
  .card{
    background:var(--bg-elevated);
    border:1px solid var(--line);
    border-radius:var(--radius-md);
    padding:26px 24px;
    box-shadow:var(--shadow);
  }
  .benefit-card svg{
    width:30px; height:30px; color:var(--accent-2); margin-bottom:16px;
  }
  .benefit-card h3{
    font-size:1.08rem; font-weight:700; margin-bottom:8px;
  }
  .benefit-card p{ color:var(--ink-dim); font-size:0.92rem; }

  /* ---------- how it works ---------- */
  .steps{
    display:grid; grid-template-columns:repeat(3,1fr); gap:24px;
    counter-reset:step;
  }
  @media (max-width:820px){ .steps{ grid-template-columns:1fr; } }
  .step{ position:relative; padding-top:8px; }
  .step-num{
    font-family:"IBM Plex Mono",monospace;
    font-size:0.78rem; color:var(--accent-2);
    letter-spacing:0.06em;
  }
  .step h3{ font-size:1.15rem; margin-top:10px; }
  .step p{ color:var(--ink-dim); margin-top:8px; font-size:0.94rem; }
  .step-line{
    display:none;
  }
  @media (min-width:821px){
    .steps{ position:relative; }
    .step:not(:last-child)::after{
      content:"";
      position:absolute; top:12px; left:calc(100% + 12px);
      width:calc(24px - 0px);
      border-top:1px dashed var(--line);
    }
  }

  /* ---------- equipment diagram ---------- */
  .equip-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:clamp(28px,5vw,56px);
    align-items:center;
  }
  @media (max-width:900px){ .equip-grid{ grid-template-columns:1fr; } }
  .equip-diagram{ position:relative; }
  .equip-diagram svg{ width:100%; height:auto; }
  .callout{
    font-family:"IBM Plex Mono",monospace;
    font-size:0.68rem;
    fill:var(--ink-dim);
  }
  .callout-val{ fill:var(--accent-2); font-weight:500; }
  .callout-dot{ fill:var(--accent-2); }
  .callout-line{ stroke:var(--line); stroke-width:1; }

  /* ---------- form ---------- */
  .form-shell{
    display:grid; grid-template-columns:0.85fr 1.15fr; gap:0;
    background:var(--bg-elevated);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow);
    overflow:hidden;
  }
  @media (max-width:880px){ .form-shell{ grid-template-columns:1fr; } }
  .form-side{
    background:
      radial-gradient(360px 260px at 20% 10%, var(--glow-a), transparent 70%),
      linear-gradient(160deg, var(--bg-sunken), var(--bg-elevated));
    padding:clamp(32px,4vw,48px);
    border-right:1px solid var(--line);
    display:flex; flex-direction:column; justify-content:space-between; gap:32px;
  }
  @media (max-width:880px){ .form-side{ border-right:none; border-bottom:1px solid var(--line); } }
  .form-side h2{ font-size:1.7rem; }
  .form-side > p{ color:var(--ink-dim); margin-top:14px; font-size:0.96rem; }
  .contact-line{
    display:flex; align-items:center; gap:12px;
    padding-top:18px; border-top:1px solid var(--line);
  }
  .contact-line svg{ width:22px; height:22px; color:var(--whatsapp); flex:none; }
  .contact-line .num{ font-family:"IBM Plex Mono",monospace; font-size:1.05rem; font-weight:500; }
  .contact-line .label{ font-size:0.72rem; color:var(--ink-faint); letter-spacing:0.05em; text-transform:uppercase; }

  .form-main{ padding:clamp(32px,4vw,48px); }
  .field-row{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:520px){ .field-row{ grid-template-columns:1fr; } }
  .field{ margin-bottom:18px; }
  .field label{
    display:block; font-size:0.78rem; font-weight:600; letter-spacing:0.03em;
    color:var(--ink-dim); margin-bottom:7px;
  }
  .field input, .field select, .field textarea{
    width:100%;
    font-family:"Manrope",sans-serif; font-size:0.96rem; color:var(--ink);
    background:var(--bg-sunken);
    border:1px solid var(--line);
    border-radius:var(--radius-sm);
    padding:12px 14px;
    transition:border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none; border-color:var(--accent);
    box-shadow:0 0 0 3px var(--glow-a);
  }
  .field textarea{ resize:vertical; min-height:88px; font-family:"Manrope",sans-serif; }
  .form-note{
    font-size:0.78rem; color:var(--ink-faint); margin-top:14px; line-height:1.5;
  }
  .form-status{
    font-size:0.86rem; margin-top:14px; min-height:1.2em;
  }
  .form-status.err{ color:#e0654a; }
  .form-status.ok{ color:var(--accent-2); }

  /* ---------- footer ---------- */
  footer{
    border-top:1px solid var(--line);
    padding:44px 0 32px;
  }
  .foot-row{
    display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap;
  }
  .foot-brand{ display:flex; align-items:center; gap:10px; }
  .foot-brand svg{ width:26px; height:26px; }
  .foot-brand span{ font-family:"Rajdhani",sans-serif; font-weight:700; }
  footer .disclaimer{
    margin-top:24px; padding-top:20px; border-top:1px solid var(--line);
    font-size:0.78rem; color:var(--ink-faint); max-width:80ch;
  }

  /* ---------- floating whatsapp ---------- */
  .float-wa{
    position:fixed; right:20px; bottom:20px; z-index:60;
    width:56px; height:56px; border-radius:50%;
    background:var(--whatsapp);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 14px 30px -10px rgba(31,184,85,0.6);
    text-decoration:none;
  }
  .float-wa svg{ width:28px; height:28px; color:#04150b; }
  .float-wa::before{
    content:"";
    position:absolute; inset:0; border-radius:50%;
    box-shadow:0 0 0 0 rgba(31,184,85,0.55);
    animation:wa-pulse 2.6s ease-out infinite;
  }
  @keyframes wa-pulse{
    0%{ box-shadow:0 0 0 0 rgba(31,184,85,0.45); }
    100%{ box-shadow:0 0 0 16px rgba(31,184,85,0); }
  }

  .reveal{ opacity:0; transform:translateY(18px); transition:opacity 0.6s ease, transform 0.6s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }
</style>
</head>
